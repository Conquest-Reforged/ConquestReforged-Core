{
	"credit": "Made with Blockbench",
	"textureSize": [64, 32],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -9, 4],
			"animations": [
				{
					"left_upper_leg.rx": "torad(-8)+limb_speed*sin(limb_swing/1)/1.2",
					"left_lower_leg.rx": "torad(10)+clamp(limb_speed*sin((limb_swing/-1)-2), -0.0, 0.5)",
					"left_lower_foot.rx": "torad(0)+clamp(limb_speed*sin((limb_swing/1)+1), -0.5, 0)*2.4",
					"l_claws.rx": "torad(10) + clamp(limb_speed * sin(limb_swing / -1), -11.2, 11) * (-2 * clamp( (abs(left_upper_leg.rx) - 0.4) / 0.2 , 0, 1 ) * signum(left_upper_leg.rx) )",
					"right_upper_leg.rx": "torad(-8) + limb_speed * -sin(limb_swing / 1) / 1.2",
					"right_lower_leg.rx": "torad(10) + clamp(limb_speed * -sin((limb_swing / -1) - 2), -0.0, 0.5)",
					"right_lower_foot.rx": "torad(0) + clamp(limb_speed * -sin((limb_swing / 1) + 1), -0.5, 0) * 2.4"
				},
				{
					"r_claws.rx": "torad(10) + clamp(limb_speed * sin(limb_swing / -1), -11.2, 11) * (2 * clamp((abs(right_upper_leg.rx) - 0.4) / 0.2, 0, 1) * signum(right_upper_leg.rx))",
					"neck1.rx": "lerp(clamp((limb_speed-0.3221)/0.5,0,1), torad(20)+sin(limb_swing/2)*limb_speed/4, torad(45)+sin(limb_swing)*limb_speed*0.01)+(head_pitch/-200)",
					"neck2.rx": "lerp(clamp((limb_speed-0.3221)/0.5,0,1), torad(22.5)+sin(limb_swing/2)*limb_speed/3, torad(55)+sin(limb_swing)*limb_speed*0.01)+(head_pitch/-300)",
					"neck3.rx": "lerp(clamp((limb_speed-0.3221)/0.5,0,1), torad(-20)+sin(limb_swing/2)*limb_speed/2, torad(-25)+sin(limb_swing)*limb_speed*0.1)+(head_pitch/-300)",
					"upper_head.rx": "lerp(clamp((limb_speed-0.3221)/0.5,0,1), torad(-42.5)+sin(limb_swing/-2)*limb_speed/1, torad(-85)+sin(limb_swing)*limb_speed*0.0)+(head_pitch/-400)",
					"neck1.ry": "head_yaw/200",
					"neck2.ry": "head_yaw/400",
					"neck3.ry": "head_yaw/300",
					"upper_head.ry": "round(head_yaw/350)",
					"upper_head.rz": "head_yaw/-90"
				},
				{
					"body_main.rx": "sin(limb_swing/2)*limb_speed/8",
					"body_main.tz": "0.9+sin(limb_swing/1)*limb_speed/4",
					"tail.rx": "sin(limb_swing)*limb_speed/5"
				},
				{
					"var.r_wing_rz_target": "if(!is_on_ground, clamp(cos(time * -1.2)*1.5, -10 ,0.6), if(limb_speed > 0.7, clamp(cos(limb_swing*1.2+1) * limb_speed*2, -10 ,0.61) ,torad(-8)))",
					"r_wing.rz": "lerp(frame_time * 10, var.r_wing_rz_prev, var.r_wing_rz_target)",
					"var.r_wing_rz_prev": "r_wing.rz",
					"var.r_wing_ry_target": "if(!is_on_ground, sin(time * -1.2)*3.0, if(limb_speed > 0.7, sin(limb_swing*1.2+1)* limb_speed*-2.5,torad(-95)))",
					"r_wing.ry": "lerp(frame_time * 10, var.r_wing_ry_prev, var.r_wing_ry_target)",
					"var.r_wing_ry_prev": "r_wing.ry",
					"var.r_wing_rx_target": "if(!is_on_ground, torad(22), if(limb_speed > 0.7, torad(22) ,torad(18)))",
					"r_wing.rx": "lerp(frame_time * 10, var.r_wing_rx_prev, var.r_wing_rx_target)",
					"var.r_wing_rx_prev": "r_wing.rx",
					"var.r_wing_2_rz_target": "if(!is_on_ground, clamp(cos(time * -1.2)*-1.8, -0 ,10), if(limb_speed > 0.7, clamp(sin(limb_swing*1.2-1)*limb_speed*3, -0 ,10),torad(-87.5)))",
					"r_wing_2.rz": "lerp(frame_time * 10, var.r_wing_2_rz_prev, var.r_wing_2_rz_target)",
					"var.r_wing_2_rz_prev": "r_wing_2.rz",
					"var.r_wing_3_rz_target": "if(!is_on_ground, clamp(cos(time  * -1.2)*2.5, -10 ,0), if(limb_speed > 0.7, clamp(cos(limb_swing*1.2)* limb_speed, -10 ,0), torad(25)))",
					"r_wing_3.rz": "lerp(frame_time * 10, var.r_wing_3_rz_prev, var.r_wing_3_rz_target)",
					"var.r_wing_3_rz_prev": "r_wing_3.rz",
					"var.l_wing_rz_target": "if(!is_on_ground, clamp(cos(time * 1.2)*-1.5, -0.6 ,10), if(limb_speed > 0.7, clamp(cos(limb_swing*1.2+1) * limb_speed*-2, -0.61 ,10) ,torad(8)))",
					"l_wing.rz": "lerp(frame_time * 10, var.l_wing_rz_prev, var.l_wing_rz_target)",
					"var.l_wing_rz_prev": "l_wing.rz",
					"var.l_wing_ry_target": "if(!is_on_ground, sin(time * 1.2)*3.0, if(limb_speed > 0.7, sin(limb_swing*1.2+1)* limb_speed*2.5,torad(95)))",
					"l_wing.ry": "lerp(frame_time * 10, var.l_wing_ry_prev, var.l_wing_ry_target)",
					"var.l_wing_ry_prev": "l_wing.ry",
					"var.l_wing_rx_target": "if(!is_on_ground, torad(22), if(limb_speed > 0.7, torad(22) ,torad(18)))",
					"l_wing.rx": "lerp(frame_time * 10, var.l_wing_rx_prev, var.l_wing_rx_target)",
					"var.l_wing_rx_prev": "l_wing.rx",
					"var.l_wing_2_rz_target": "if(!is_on_ground, clamp(0-cos(time * 1.2 * -1)*-1.8, -10 ,0), if(limb_speed > 0.7, clamp(sin(limb_swing*1.2-1)*limb_speed*-3, -10 ,0),torad(87.5)))",
					"l_wing_2.rz": "lerp(frame_time * 10, var.l_wing_2_rz_prev, var.l_wing_2_rz_target)",
					"var.l_wing_2_rz_prev": "l_wing_2.rz",
					"var.l_wing_3_rz_target": "if(!is_on_ground, clamp(-cos(time * 1.2 * -1)*2.5, -0 ,10), if(limb_speed > 0.7, clamp(0-cos(limb_swing*1.2)* limb_speed, -0 ,10), torad(-25)))",
					"l_wing_3.rz": "lerp(frame_time * 10, var.l_wing_3_rz_prev, var.l_wing_3_rz_target)",
					"var.l_wing_3_rz_prev": "l_wing_3.rz"
				}
			]
		},
