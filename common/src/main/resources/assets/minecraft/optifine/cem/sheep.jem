					"body_base.rx": "if(limb_speed > 0.0 , sin(limb_swing+4)*limb_speed/9,0)",
					"BackLegRight.rx": "torad(-7.5)-sin(limb_swing)*limb_speed/1.6",
					"BackLegRight2.rx": "clamp(torad(42.5)-sin(limb_swing+1.2)*limb_speed*-1, 0,100)",
					"BackLegRight3.rx": "clamp(torad(-35)-sin(limb_swing+1.2)*limb_speed, -100, 0)",
					"BackLegLeft.rx": "if(limb_speed > 0.6 ,torad(-7.5)-sin(limb_swing+0)*limb_speed/1.1,torad(-7.5)-sin(limb_swing/-1)*limb_speed/1.6)",
					"BackLegLeft2.rx": "if(limb_speed > 0.6 ,clamp(torad(42.5)-sin(limb_swing+0.9)*limb_speed*-1, 0,100),clamp(torad(42.5)-sin(limb_swing+1.6)*limb_speed*1, 0,100))",
					"BackLegLeft3.rx": "if(limb_speed > 0.6 ,clamp(torad(-35)-sin(limb_swing+0.6)*limb_speed*1, -100, 0),clamp(torad(-35)-sin(limb_swing+1.6)*limb_speed*-1, -100, 0))",
					"FrontLegRight.rx": "sin(limb_swing+2)*limb_speed/2",
					"FrontLegRight2.rx": "clamp(sin(limb_swing+3.2)*limb_speed*-1, 0,100)",
					"FrontLegLeft.rx": "if(limb_speed > 0.6 ,sin(limb_swing)*limb_speed/-2,sin(limb_swing)*limb_speed/2)",
					"FrontLegLeft2.rx": "if(limb_speed > 0.6 ,clamp(sin(limb_swing+1.2)*limb_speed*1, 0,100),clamp(sin(limb_swing+1.2)*limb_speed*-1, 0,100))",
					"head.ty": "if(limb_speed > 0.0 , sin(limb_swing)*limb_speed/-1.6+6,6)",
					"neck.rx": "head.rx/2",
					"neck.ry": "head.ry/2",
					"head_base.rx": "head.rx/2",
					"head_base.ry": "head.ry/2",
					"head_base.rz": "head.rz/2",
					"head_base.tz": "(6.5+head.tz)*2",
					"head_base.ty": "(-10+head.ty)*2",
					"head_base.sx": "head.sx",
					"head_base.sy": "head.sy",
					"head_base.sz": "head.sz"
				}
			]
