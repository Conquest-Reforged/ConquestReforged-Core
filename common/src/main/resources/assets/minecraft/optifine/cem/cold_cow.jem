{
	"credit": "Made with Blockbench",
	"textureSize": [512, 512],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -20, 8],
			"animations": [
				{
					"body.sx": "if(!is_child,  1.2, 1.1)",
					"body.sy": "if(!is_child,  1.2, 1.1)",
					"body.sz": "if(!is_child,  1.2, 1.1)",
					"body.ty": "if(!is_child,  1.2, 4.2)",
					"cabeza.rx": "torad(-20) - head_pitch/150",
					"cabeza.ry": "(-head_yaw)/90",
					"cabeza.rz": "-head.rz",
					"cola.rz": "-leg1.rx",
					"neck_inner2.ry": "-head_yaw/580",
					"leg1_1.rx": "if(limb_speed < 0.5,    sin(limb_swing)*limb_speed/-1.5,                       cos(limb_swing+1)*limb_speed/2.0)",
					"leg1_2.rx": "clamp(sin(limb_swing+1.5)*limb_speed/-1.2,-100, 0)",
					"leg1_3.rx": "clamp(sin(limb_swing+1.5)*limb_speed/1.2,0, 100)",
					"leg2_1.rx": "if(limb_speed < 0.5,    sin(limb_swing)*limb_speed/1.5,                       cos(limb_swing+2)*limb_speed/2.0)",
					"leg2_2.rx": "if(limb_speed < 0.5,    clamp(sin(limb_swing+1.5)*limb_speed/1.2,-100, 0),    clamp(sin(limb_swing-1.5)*limb_speed/1.2,-100, 0))",
					"leg2_3.rx": "if(limb_speed < 0.5,    clamp(sin(limb_swing+1.5)*limb_speed/-1.2,0, 100),    clamp(sin(limb_swing-1.5)*limb_speed/-1.2,0, 100))",
					"leg3_1.rx": "if(limb_speed < 0.01,   0,  limb_speed < 0.5, sin(limb_swing)*limb_speed/1,     cos(limb_swing)*limb_speed/2)",
					"leg3_2.rx": "if(limb_speed < 0.01,   0,  clamp(sin(limb_swing+2.8)*limb_speed/1,-100, 0))",
					"leg3_3.rx": "if(limb_speed < 0.01,   0,  clamp(sin(limb_swing+2.8)*limb_speed/-1,0, 100))",
					"leg4_1.rx": "if(limb_speed < 0.5,    sin(limb_swing)*limb_speed/-1,sin(limb_swing)*limb_speed/-2)",
					"leg4_2.rx": "if(limb_speed < 0.01,   0, clamp(sin(limb_swing+2)*limb_speed/-1,-100, 0))",
					"leg4_3.rx": "if(limb_speed < 0.01,   0, clamp(sin(limb_swing+2)*limb_speed/1, 0, 100))",
					"body_base.rx": "if(limb_speed > 0.0 , sin(limb_swing)*limb_speed/18,0)",
					"cabeza.sx": "if(is_child,  1.4, 1)",
					"cabeza.sy": "if(is_child, 1.4, 1)",
					"cabeza.sz": "if(is_child, 1.4, 1)",
					"body/belly.sz": "if(is_child, 0.8, 1)"
				}
			]
		},
