			"animations": [
				{
					"blink.tz": "120.5-clamp(sin(time*0.1+random(id))*123,122.20,122.30)",
					"back.rx": "if(limb_speed < 0.5 ,torad(-9.5)+sin(limb_swing*-1.03)*limb_speed*0.01, torad(-9.5)+sin(limb_swing*-1.03)*limb_speed*0.101)",
					"back2.rx": "if(limb_speed < 0.5 ,torad(-32.5)+head_pitch/-300+sin(+time*random(id)/11)/21, torad(-32.5)+head_pitch/-400+sin(+time*random(id)/111)/11)+asin(limb_speed/2)",
					"back3.rx": "torad(40)+head_pitch/300+sin(time*random(id)/11)/21",
					"back4.rx": "torad(37.5)+head_pitch/300+sin(time*random(id)/11)/21",
					"back2.rz": "sin((+time*random(id))/111.2*pi)/21",
					"back3.rz": "sin((+time*random(id))/111.2*pi)/21",
					"back4.rz": "sin((+time*random(id))/111.2*pi)/21",
					"back2.ry": "torad(-0)+head_yaw/400",
					"back3.ry": "torad(0)+head_yaw/400",
					"back4.ry": "torad(0)+head_yaw/400",
					"head_base.ry": "torad(-0)+head_yaw/100",
					"head_base.rx": "torad(-22)+sin((limb_speed/6.2)*(limb_swing/200))/8+head_pitch/500-0.2",
					"legbr.rx": "torad(-7)+sin(((limb_swing/3)*pi+1))*limb_speed/-1.5",
					"legbr.ty": "-3+sin(((limb_swing/3)*pi+1))*limb_speed*-1.5",
					"legbr.tz": "-1+sin((limb_swing/3)*pi)*limb_speed*-1.5",
					"legbr.rz": "torad(5)-sin(limb_swing*pi/3)*limb_speed*-0.22",
					"legbl.rx": "torad(-7)+sin(((limb_swing/3)*pi+1))*limb_speed/1.5",
					"legbl.ty": "-3+sin(((limb_swing/3)*pi+1))*limb_speed*1.5",
					"legbl.tz": "-1+sin((limb_swing/3)*pi)*limb_speed*1.5",
					"legbl.rz": "torad(-5)-sin(limb_swing*pi/3)*limb_speed*-0.22",
					"legfr.rx": "torad(-7)+sin(((limb_swing/3)*pi+1))*limb_speed/1.5",
					"legfr.ty": "-3.5+sin(((limb_swing/3)*pi+1))*limb_speed*1.5",
					"legfr.tz": "-7+sin((limb_swing/3)*pi)*limb_speed*1.5",
					"legfr.rz": "torad(5)-sin(limb_swing*pi/3)*limb_speed*0.22",
					"legfl.rx": "torad(-7)+sin(((limb_swing/3)*pi+1))*limb_speed/-1.5",
					"legfl.ty": "-3.5+sin(((limb_swing/3)*pi+1))*limb_speed*-1.5",
					"legfl.tz": "-7+sin((limb_swing/3)*pi)*limb_speed*-1.5",
					"legfl.rz": "torad(-5)-sin(limb_swing*pi/3)*limb_speed*0.22"
				}
			]
		},
