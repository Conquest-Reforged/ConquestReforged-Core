{
	"credit": "Made with Blockbench",
	"textureSize": [64, 64],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -22, 9],
			"animations": [
				{
					"var.pause": "1",
					"BackLegLeft.rx": "if(limb_speed < 0.5, sin(limb_swing)*limb_speed/-1.5-0.0+if(neck.ty < 4 ,0.4,0)*var.pause, (cos(limb_swing-11)+limb_speed/1.0)/1.3-0.5)",
					"BackLegLeft2.rx": "torad(45)-clamp(sin(limb_swing+1.5)*limb_speed/-1.2,-100, 0)",
					"BackLegLeft3.rx": "torad(-45)-clamp(sin(limb_swing+1.5)*limb_speed/1.2,0, 100)",
					"BackLegRight.rx": "if(limb_speed < 0.5,sin(limb_swing)*limb_speed/1.5+0.0+if(neck.ty < 4 ,0.7,0)*var.pause,(cos(limb_swing+1)*limb_speed/1.0-0.0))",
					"BackLegRight2.rx": "torad(45)-if(limb_speed < 0.5,    clamp(sin(limb_swing+1.5)*limb_speed/1.2,-100, 0),    clamp(sin(limb_swing-1.5)*limb_speed/1.2,-100, 0))",
					"BackLegRight3.rx": "torad(-45)-if(limb_speed < 0.5,    clamp(sin(limb_swing+1.5)*limb_speed/-1.2,0, 100),    clamp(sin(limb_swing-1.5)*limb_speed/-1.2,0, 100))",
					"FrontLegRight3.rx": "torad(-5)-if(limb_speed < 0.01,   0,  limb_speed < 0.5, sin(limb_swing)*limb_speed/-1,     sin(limb_swing)*limb_speed/2)+if(neck.ty < 4 ,torad(-20)+sin(time/1.5)/1.3,0)*var.pause",
					"FrontLegRight.rx": "torad(5)-if(limb_speed < 0.01,   0, limb_speed < 0.5, clamp(sin(limb_swing+2)*limb_speed/-1,0, 100)  ,  clamp(sin(limb_swing+1)*limb_speed/1.2,0, 100))+if(neck.ty < 4 ,clamp(torad(-30)+sin(time/-3)/2,-100,0),0)*var.pause",
					"FrontLegRight2.rx": "torad(0)-if(limb_speed < 0.01,   0, limb_speed < 0.5, clamp(sin(limb_swing+2)*limb_speed/-1,-100, 0)  , clamp(sin(limb_swing+1.2)*limb_speed/-1,-100, 0))+if(neck.ty < 4 ,clamp(torad(30)+sin(time/3)/2,0,100),0)*var.pause",
					"FrontLegLeft3.rx": "torad(-5)-if(limb_speed < 0.01,   0,  limb_speed < 0.5, sin(limb_swing)*limb_speed/1,     cos(limb_swing)*limb_speed/-2)+if(neck.ty < 4 ,torad(-20)+sin(time/1.5-2)/1.3,0)*var.pause",
					"FrontLegLeft.rx": "torad(5)-if(limb_speed < 0.01,   0, limb_speed < 0.5, clamp(sin(limb_swing+2)*limb_speed/1,0, 100)  ,  clamp(sin(limb_swing+0)*limb_speed/1,0, 100))+if(neck.ty < 4 ,clamp(torad(-30)+cos(time/-3-1)/2,-100,0),0)*var.pause",
					"FrontLegLeft2.rx": "torad(0)-if(limb_speed < 0.01,   0, limb_speed < 0.5, clamp(sin(limb_swing+2)*limb_speed/-1,-100, 0)  , clamp(sin(limb_swing+0)*limb_speed/-1,-100, 0))+if(neck.ty < 4 ,clamp(torad(30)+sin(time/3-1)/2,0,100),0)*var.pause",
					"FrontLegLeft3.visible": "!is_child",
					"FrontLegRight3.visible": "!is_child",
					"BackLegLeft.visible": "!is_child",
					"BackLegRight.visible": "!is_child",
					"FrontLegRight.visible": "!is_child",
					"FrontLegLeft.visible": "!is_child",
					"head2.rx": "if(neck.rx > 1.8 ,-0.5,0)",
					"head.rx": "head.rx",
					"gear.visible": "is_ridden",
					"rein.visible": "is_ridden",
					"rein.rx": "torad(0)-(neck.rx/2)"
				}
			]
		},
